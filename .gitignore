# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/
.env

# ---- Scenario log ----
# Databases written by the command line's scenario log; regenerated by use.
*.db
*.sqlite3

# ---- Quarto ----
# Rendered output and caches. The page lives in docs/; Quarto's own ignore
# lines for that project are in docs/.gitignore.
_book/
_site/
_freeze/
# Quarto's intermediate notebooks, chapter.quarto_ipynb_1 included.
*.quarto_ipynb*
# Quarto looks for these two lines, exactly as written, on every render, and
# rewrites the whole file to append any that is missing. Keep both, verbatim.
/.quarto/
**/*.quarto_ipynb
# Extensions installed by "quarto add" before each render.
docs/_extensions/

# ---- Local working material ----
# Working material kept beside the project, excluded from version control
# by this file (not by .git/info/exclude).
excluded/

# ---- Local notes ----
# A separate local repository, not part of this project.
/black-scholes-option-pricer-private/
# Backstop: if a note lands here by mistake, git will not take it.
/handoff.txt
/backlog.txt
/backup.txt
/devnotes.txt

# ---- Update zips ----
# Temporary archives, extracted in place and then deleted.
/*-update-*.zip

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
